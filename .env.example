# TEMPLATE ONLY — this file IS committed, so keep every value BLANK (rule 5).
# Copy this to `.env` (gitignored) and put your REAL keys there. Then mirror the
# same values into the GitHub Actions secrets of the cron repo. See docs/03-setup-guide.md.

# Ideation (primary = Claude Code / Routine — runs in Anthropic's cloud, not here)
CLAUDE_CODE_OAUTH_TOKEN=

# LLM (scripts + ideation fallback)
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional 3rd LLM provider — GitHub Models (free with a GitHub plan; OpenAI/Llama/DeepSeek
# catalog, NO Anthropic model, so it is never a route around rule 4). OPT-IN: a token alone does
# not enable it, because an unconfigured provider in the chain just delays the real failover.
# Use a token whose ONLY scope is `models: read` — never reuse GH_PAT (Actions read+write).
# NOTE the GH_ prefix: GitHub REJECTS secret/variable names beginning with `GITHUB_`, so these
# deliberately avoid that prefix or they could never be created as Actions secrets/vars.
GH_MODELS_KEY=                      # PAT with `models: read`
ENABLE_GH_MODELS=                   # false (default) | true — add as a middle fallback
PREFER_GH_MODELS=                   # false (default) | true — try it FIRST (implies enabled)
GH_MODEL=                           # publisher/model (default openai/gpt-4o-mini)

# Database
SUPABASE_URL=
SUPABASE_KEY=

# Approval
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVAL_MODE=webhook       # webhook for Vercel bot; polling only when no Telegram webhook is set

# Telegram control bot (Vercel webhook — see telegram-bot/README.md). Set these in the Vercel
# project env; WEBHOOK_SECRET also goes in local .env so tools/set_telegram_webhook.py can register it.
WEBHOOK_SECRET=                     # any random string; must match the value set in Vercel
GH_PAT=                             # GitHub token (Actions: read+write) so /makeshort can start the run
GH_REPO=                           # e.g. Shaan-alpha/AI-Reel-Factory

# Visuals
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Edit polish (assembly): all optional, sensible defaults, all fail-soft (a filter error
# falls back to a plain render so the daily batch never dies).
ENABLE_XFADE=          # true (default) | false — crossfade transitions between cuts
XFADE_SECONDS=         # crossfade overlap seconds (default 0.35)
ENABLE_GRADE=          # true (default) | false — cinematic color grade
GRADE_CONTRAST=        # default 1.06
GRADE_SATURATION=      # default 1.12
ENABLE_VIGNETTE=       # true (default) | false
ENABLE_GRAIN=          # true (default) | false — subtle film grain
GRAIN_STRENGTH=        # noise alls value (default 8)

# Retention refinements v2 (scriptwriter / assembly / subtitles): optional, fail-soft.
SCRIPT_MAX_WORDS=      # hard cap; over -> truncate to last full sentence (default 80)
ENABLE_DUCKING=        # true (default) | false — sidechain-duck music under the voice
ENABLE_BRAND_BUG=      # true (default) | false — corner logo overlay (skips if file absent)
BRAND_LOGO=            # logo path (default assets/brand/logo.png)
BRAND_LOGO_HEIGHT=     # overlay height px (default 150)
BRAND_LOGO_OPACITY=    # 0..1 (default 0.55)
BRAND_LOGO_MARGIN=     # corner margin px (default 44)
ENABLE_SOURCE_CITE=    # true (default) | false — first-~3s "Source: domain" lower-third
SOURCE_CITE_SECONDS=   # how long the citation shows (default 3.0)
ENABLE_SEAMLESS_LOOP=  # true (default) | false — end clip reuses the opening shot

# Procedural SFX (audio_sfx → assembly): transition stings on clip cuts. Stdlib wave synthesis,
# no assets to download, fail-soft. Kept quiet + sparse on purpose: the mix sums without headroom
# (a limiter caps it), a sting on every cut sounds cheap, and the hook must stay clean.
ENABLE_SFX=            # true (default) | false — master switch for cut transition SFX
SFX_VOLUME=            # 0..1 (default 0.18) — 0 disables; >0.3 starts fighting the narration
SFX_EVERY_N_CUTS=      # mark every Nth cut (default 2); 1 = every cut (busy)
SFX_DIR=               # where generated SFX wavs are cached (default assets/sfx)

# Voice (TTS) — Google Cloud Chirp 3 HD primary; falls back to edge-tts en-IN, then Kokoro.
VOICE_ENGINE=gemini                 # gemini | google | edge | kokoro (rest follow as a fallback
                                    # chain). 'gemini' is the only engine that can sound genuinely
                                    # sarcastic; it is opt-in and absent from the chain otherwise.
GOOGLE_TTS_API_KEY=                 # TTS-restricted key; set a $5 budget cap + alert in Google Cloud
GOOGLE_TTS_VOICE=                   # run tools/list_google_voices.py, paste an en-IN Chirp3-HD name
GOOGLE_TTS_LANGUAGE=en-IN
GOOGLE_TTS_SPEAKING_RATE=           # 0.25-2.0 (unset = engine default). NOTE: Chirp-only, and
                                    # Chirp is now the FALLBACK — this has no effect unless the
                                    # gemini engine fails. Pace the primary via VOICE_STYLE_PROMPT.

# Expressive delivery. The control signals are NOT portable between engines, so the scriptwriter
# emits both tag families and each engine keeps only what it understands:
#   [pause] / [pause long]              -> Chirp 3 HD, via its `markup` input field
#   [sarcastic] / [deadpan] / [dry]     -> Gemini TTS (inline audio tags)
#   edge-tts + Kokoro                   -> no tag support; everything is stripped
ENABLE_PAUSE_MARKUP=                # true (default) | false — send [pause] tags as Chirp markup
MAX_PAUSE_TAGS=                     # cap on pause tags per script (default 3)
MAX_STYLE_TAGS=                     # cap on style tags per script (default 3)
VOICE_STYLE_PROMPT=                 # style instruction for the Gemini TTS engine; default is dry
                                    # deadpan sarcasm. ONLY the gemini engine honours this.
GEMINI_TTS_MODEL=                   # default gemini-2.5-flash-preview-tts (FREE on input+output).
                                    # gemini-2.5-pro-preview-tts has NO free tier: ~$1.27/mo at
                                    # 3 Shorts/day. Compare both: tools/compare_voices.py
GEMINI_TTS_VOICE=                   # default Zubenelgenubi ("Casual") — chosen by ear over Kore /
                                    # Schedar / Algenib / Charon. A BARE name, NOT the
                                    # en-IN-Chirp3-HD- form. Re-pick via tools/tune_voice.py
GEMINI_TTS_API_KEY=                 # optional 2nd key; falls back to GEMINI_API_KEY. NOT needed in
                                    # practice: AI Studio meters PER MODEL, so TTS has its own
                                    # bucket and cannot starve grounded ideation. Kept as an
                                    # escape hatch only. Free-tier Gemini 2.5 Flash TTS (measured
                                    # 2026-07-27): 3 RPM / 10K TPM / 10 RPD.

# Captions (active-word karaoke)
CAPTION_FONT=Montserrat             # bundled in assets/fonts; resolved by libass via fontsdir
CAPTION_HIGHLIGHT_COLOR=&H0000FFFF  # ASS &HBBGGRR (yellow) — the active word's fill colour
ENABLE_TEXT_CARDS=true              # burn short on-screen key-point cards (story-specific visuals)
CARD_SECONDS=1.8                    # how long each key-point card flashes
ENABLE_GRAPHIC_CARDS=               # false (default) | true — render key-point cards as PIL stat-card
                                    # PNGs (rounded box + border) instead of plain ASS text. Falls
                                    # back to the ASS cards on any failure. Flip it for one run and
                                    # look at the result before leaving it on.
CAPTION_FONT_FILE=                  # ttf used by libass staging AND the stat cards
                                    # (default assets/fonts/Montserrat-Bold.ttf)

# YouTube publishing
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
ENABLE_CHANNEL_TAGS=                # true (default) | false — append the 5 core channel tags
                                    # (But It Matters, News Shorts, …) after the SEO tags. They go
                                    # LAST, so publish._cap_tags drops them first if the ~480-char
                                    # tag budget runs out — the per-story SEO tags always win.

# Config
CHANNEL_NAME=But It Matters         # brand name (also used in disclosure/branding)
NICHE=impact-news                   # daily impact news/info explainers (India + world)
NICHE_LEAN=soft-positive            # science/tech/economy/breakthroughs; avoid partisan/communal
CONTENT_STYLE=daily-impact-explainer   # what happened -> why it matters -> impact
DIGEST_HOUR_UTC=02                  # 08:00 IST ~= 02:30 UTC (adjust to your timezone)
ENABLE_FALLBACK_IDEATION=true       # use Gemini/Groq only if Claude didn't produce ideas
AI_DISCLOSURE=true                  # set YouTube altered/synthetic flag + disclosure line
MIN_SOURCES=2                       # min independent sources before an idea becomes a reel
DAILY_REEL_CAP=3                    # max Shorts produced per run (operator ships 3/day)
APPROVAL_CAP=3                      # max approvals accepted per digest; keep == DAILY_REEL_CAP
                                    # so the queue can't outrun what production will actually make
ENABLE_HUMAN_ANGLE=true             # require a genuine "why it matters" take (originality / anti-AI-slop)
NEWS_RSS_URL=                       # optional: override the Google News RSS feed that seeds ideation
