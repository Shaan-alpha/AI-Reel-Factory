# TEMPLATE ONLY — this file IS committed, so keep every value BLANK (rule 5).
# Copy this to `.env` (gitignored) and put your REAL keys there. Then mirror the
# same values into the GitHub Actions secrets of the cron repo. See docs/03-setup-guide.md.

# Ideation (primary = Claude Code / Routine — runs in Anthropic's cloud, not here)
CLAUDE_CODE_OAUTH_TOKEN=

# LLM (scripts + ideation fallback)
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=                       # UNGROUNDED text. Default gemini-3.6-flash. Free-tier quota is
                                    # metered PER MODEL, so each newer model brings its own daily
                                    # budget: measured 2026-08-07, 3.6/3.5-flash, 3.5/3.1-flash-lite
                                    # and 3-flash-preview all answered while gemini-2.5-flash was
                                    # returning `limit: 20`. Bump freely — this knob is now safe.
GEMINI_GROUNDED_MODEL=              # GROUNDED web research. Default gemini-2.5-flash. DO NOT point
                                    # this at a 3.x model: Google Search grounding 429s on every
                                    # one of them with no free allowance (measured 2026-08-07), so
                                    # a "bump" here silently kills grounded ideation, the grounded
                                    # scriptwriter AND the fact-check gate at once. It is a separate
                                    # knob from GEMINI_MODEL for exactly that reason.
GROQ_MODEL=                         # default llama-3.3-70b-versatile

# Optional 3rd LLM provider — GitHub Models (free with a GitHub plan; OpenAI/Llama/DeepSeek
# catalog, NO Anthropic model, so it is never a route around rule 4). OPT-IN: a token alone does
# not enable it, because an unconfigured provider in the chain just delays the real failover.
# Use a token whose ONLY scope is `models: read` — never reuse GH_PAT (Actions read+write).
# NOTE the GH_ prefix: GitHub REJECTS secret/variable names beginning with `GITHUB_`, so these
# deliberately avoid that prefix or they could never be created as Actions secrets/vars.
# (The code also reads GITHUB_TOKEN as a fallback — that is the token Actions injects for itself,
#  usable with `permissions: models: read`. Deliberately NOT a field here: set GH_MODELS_KEY.)
GH_MODELS_KEY=                      # PAT with `models: read`
ENABLE_GH_MODELS=                   # false (default) | true — add as a middle fallback
PREFER_GH_MODELS=                   # false (default) | true — try it FIRST (implies enabled)
GH_MODEL=                           # publisher/model (default openai/gpt-4o-mini)

# Database
SUPABASE_URL=
SUPABASE_KEY=

# Approval
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVAL_MODE=webhook       # webhook for Vercel bot; polling only when no Telegram webhook is set

# Telegram control bot (Vercel webhook — see telegram-bot/README.md). Set these in the Vercel
# project env; WEBHOOK_SECRET also goes in local .env so tools/set_telegram_webhook.py can register it.
WEBHOOK_SECRET=                     # any random string; must match the value set in Vercel
GH_PAT=                             # GitHub token (Actions: read+write) so /makeshort can start the run
GH_REPO=                           # e.g. Shaan-alpha/AI-Reel-Factory

# Visuals
PEXELS_API_KEY=
PIXABAY_API_KEY=
VISUAL_SOURCE=         # photos (default) | ai | video — 'photos' = Pexels stills + Ken Burns
IMAGE_STYLE=           # AI-image look override (default: cinematic, photorealistic, dramatic
                       # lighting, shallow depth of field)
CF_API_TOKEN=          # optional: Cloudflare Workers AI, only used when VISUAL_SOURCE=ai
CF_ACCOUNT_ID=         # optional: pairs with CF_API_TOKEN
CF_IMAGE_MODEL=        # default @cf/black-forest-labs/flux-1-schnell

# Edit polish (assembly): all optional, sensible defaults, all fail-soft (a filter error
# falls back to a plain render so the daily batch never dies).
ENABLE_XFADE=          # true (default) | false — crossfade transitions between cuts
XFADE_SECONDS=         # crossfade overlap seconds (default 0.35)
ENABLE_GRADE=          # true (default) | false — cinematic color grade
GRADE_CONTRAST=        # default 1.06
GRADE_SATURATION=      # default 1.12
ENABLE_VIGNETTE=       # true (default) | false
ENABLE_GRAIN=          # true (default) | false — subtle film grain
GRAIN_STRENGTH=        # noise alls value (default 8)
CLIP_SECONDS=          # B-roll cut length, clamped to [1.5, 8.0] (default 3.5) — fast cuts are
                       # pattern-interrupts AND shorter single-clip use is more copyright-safe
ENABLE_MUSIC=          # true (default) | false — mix a looped bed under the narration
MUSIC_DIR=             # where the beds live (default assets/music); empty dir -> skipped
MUSIC_VOLUME=          # bed level (code default 0.12; BOTH workflows pass 0.10, which wins in CI)

# Retention refinements v2 (scriptwriter / assembly / subtitles): optional, fail-soft.
SCRIPT_MAX_WORDS=      # hard cap; over -> truncate to last full sentence (default 80)
ENABLE_DUCKING=        # true (default) | false — sidechain-duck music under the voice
ENABLE_BRAND_BUG=      # true (default) | false — corner logo overlay (skips if file absent)
BRAND_LOGO=            # logo path (default assets/brand/logo.png)
BRAND_LOGO_HEIGHT=     # overlay height px (default 150)
BRAND_LOGO_OPACITY=    # 0..1 (default 0.55)
BRAND_LOGO_MARGIN=     # corner margin px (default 44)
ENABLE_SOURCE_CITE=    # true (default) | false — first-~3s "Source: domain" lower-third
SOURCE_CITE_SECONDS=   # how long the citation shows (default 3.0)
ENABLE_SEAMLESS_LOOP=  # true (default) | false — end clip reuses the opening shot

# Procedural SFX (audio_sfx → assembly): transition stings on clip cuts. Stdlib wave synthesis,
# no assets to download, fail-soft. Kept quiet + sparse on purpose: the mix sums without headroom
# (a limiter caps it), a sting on every cut sounds cheap, and the hook must stay clean.
ENABLE_SFX=            # true (default) | false — master switch for cut transition SFX
SFX_VOLUME=            # 0..1 (default 0.18) — 0 disables; >0.3 starts fighting the narration
SFX_EVERY_N_CUTS=      # mark every Nth cut (default 2); 1 = every cut (busy)
SFX_DIR=               # where generated SFX wavs are cached (default assets/sfx)

# Voice (TTS) — Gemini TTS primary (Zubenelgenubi); falls back to Chirp 3 HD, edge-tts, Kokoro.
VOICE_ENGINE=gemini                 # gemini | google | edge | kokoro (rest follow as a fallback
                                    # chain). 'gemini' is the only engine that can sound genuinely
                                    # sarcastic — it honours the style prompt AND inline tags.
GOOGLE_TTS_API_KEY=                 # TTS-restricted key; set a $5 budget cap + alert in Google Cloud
GOOGLE_TTS_VOICE=                   # run tools/list_google_voices.py, paste an en-IN Chirp3-HD name
                                    # KEEP THIS en-IN-Chirp3-HD-Zubenelgenubi — the SAME name the
                                    # Gemini primary uses. Chirp is the fallback, so any other voice
                                    # means a double Gemini 503 silently swaps the channel's narrator
                                    # mid-catalogue. It was Kore (female) against a male primary
                                    # until 2026-08-25.
GOOGLE_TTS_LANGUAGE=en-IN
GOOGLE_TTS_SPEAKING_RATE=           # 0.25-2.0 (unset = engine default). NOTE: Chirp-only, and
                                    # Chirp is now the FALLBACK — this has no effect unless the
                                    # gemini engine fails. Pace the primary via VOICE_STYLE_PROMPT.

# Fallback-engine settings (edge-tts, then Kokoro). These only take effect once gemini AND Chirp
# have both failed, so treat them as insurance rather than tuning knobs.
VOICE_RATE=                         # edge-tts speed, e.g. +10% (default +0%)
KOKORO_VOICE=                       # default af_heart
KOKORO_SPEED=                       # default 1.0 (lower = slower/more natural)
KOKORO_LANG=                        # default en-us
KOKORO_CACHE=                       # where the ~120 MB int8 model caches (default ~/.cache/kokoro)
ENABLE_DRAMATIC_PACING=             # true (default) | false — sentence-wise synth with a longer
                                    # beat before the payoff. KOKORO-ONLY, so it is three
                                    # fallbacks deep; the primary path uses pause tags instead.
PAUSE_BETWEEN=                      # inter-sentence silence, seconds (default 0.18)
PAUSE_BEFORE_PAYOFF=                # longer beat before the final line (default 0.5)

# Expressive delivery. The control signals are NOT portable between engines, so the scriptwriter
# emits both tag families and each engine keeps only what it understands:
#   [pause] / [pause long]              -> Chirp 3 HD, via its `markup` input field
#   [sarcastic] [serious] [curious]     -> Gemini TTS (inline audio tags)
#   [whispers] [tired] [mischievously]
#   [deadpan] [dry] [amused] [flat] [sighs] [laughs]
#   edge-tts + Kokoro                   -> no tag support; everything is stripped
# The allow-list (voice._STYLE_TAGS) is curated, not exhaustive: [excited]/[amazed]/[giggles] are
# documented and would work but fight the deadpan register, and [crying]/[panicked]/[trembling]/
# [gasp]/[shouting] are excluded because melodrama over real events drifts toward the tragedy
# exploitation rule 6 forbids. Anything outside the list is stripped, never forwarded.
ENABLE_PAUSE_MARKUP=                # true (default) | false — send [pause] tags as Chirp markup
MAX_PAUSE_TAGS=                     # cap on pause tags per script (default 3)
MAX_STYLE_TAGS=                     # cap on style tags per script (default 3)
ENABLE_TAG_FLOOR=                   # true (default) | false — guarantee at least ONE delivery tag,
                                    # [serious] on the "why it matters" turn. The prompt says "at
                                    # most 3", which permits zero: measured 2026-08-07, 2 of the
                                    # last 5 produced scripts shipped with no tags at all. Fail-
                                    # soft — if the payoff sentence can't be located confidently
                                    # the script is left alone, since a tag in the wrong place is
                                    # worse than no tag.
VOICE_STYLE_PROMPT=                 # style instruction for the Gemini TTS engine; default is dry
                                    # deadpan sarcasm. ONLY the gemini engine honours this.
GEMINI_TTS_MODEL=                   # default gemini-3.1-flash-tts-preview — FREE on input+output,
                                    # and the operator's pick by ear on 2026-08-07 (ranked
                                    # 3.1-flash > 2.5-flash > Chirp on an identical script).
                                    # It IS flaky: 503 "high demand" on 3 of 4 attempts that day.
                                    # That is survivable because the preference order and the
                                    # fallback order are the same — a 503 drops to
                                    # gemini-2.5-flash-preview-tts with the SAME voice, i.e. the
                                    # second-favourite sound, never a surprise.
                                    # gemini-2.5-pro-preview-tts has NO free tier (~$1.27/mo at
                                    # 3 Shorts/day) and 429s without billing. tools/compare_voices.py
GEMINI_TTS_VOICE=                   # default Zubenelgenubi ("Casual") — chosen by ear over Kore /
                                    # Schedar / Algenib / Charon. A BARE name, NOT the
                                    # en-IN-Chirp3-HD- form. Re-pick via tools/tune_voice.py
GEMINI_TTS_API_KEY=                 # optional 2nd key; falls back to GEMINI_API_KEY. NOT needed in
                                    # practice: AI Studio meters PER MODEL, so TTS has its own
                                    # bucket and cannot starve grounded ideation. Kept as an
                                    # escape hatch only. Free-tier Gemini 2.5 Flash TTS (measured
                                    # 2026-07-27): 3 RPM / 10K TPM / 10 RPD.

# Captions (active-word karaoke)
CAPTION_FONT=Montserrat             # bundled in assets/fonts; resolved by libass via fontsdir
CAPTION_HIGHLIGHT_COLOR=&H0000FFFF  # ASS &HBBGGRR (yellow) — the active word's fill colour
ENABLE_TEXT_CARDS=true              # burn short on-screen key-point cards (story-specific visuals)
CARD_SECONDS=1.8                    # how long each key-point card flashes
ENABLE_GRAPHIC_CARDS=               # false (default) | true — render key-point cards as PIL stat-card
                                    # PNGs (rounded box + border) instead of plain ASS text. Falls
                                    # back to the ASS cards on any failure. Flip it for one run and
                                    # look at the result before leaving it on.
CAPTION_FONT_FILE=                  # ttf used by libass staging AND the stat cards
                                    # (default assets/fonts/Montserrat-Bold.ttf)
CAPTION_WORDS=                      # words per karaoke phrase (code default 2; BOTH workflows
                                    # pass 3, which wins in CI). 1 = strict karaoke, 2-3 = readable
ENABLE_HOOK_CAPTION=                # true (default) | false — bold frame-1 title banner. Frame 1 IS
                                    # the in-feed thumbnail, so this is the biggest free CTR lever
HOOK_SECONDS=                       # how long the hook banner shows (default 1.8)
WHISPER_MODEL=                      # faster-whisper size for word timings (default base)

# YouTube publishing
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=                    # public (default) | unlisted | private — set 'unlisted' for
                                    # safe first runs
YOUTUBE_CATEGORY_ID=                # default 25 (News & Politics)
ENABLE_CHANNEL_TAGS=                # true (default) | false — append the 5 core channel tags
                                    # (But It Matters, News Shorts, …) after the SEO tags. They go
                                    # LAST, so publish._cap_tags drops them first if the ~480-char
                                    # tag budget runs out — the per-story SEO tags always win.

# Config
CHANNEL_NAME=But It Matters         # brand name (also used in disclosure/branding)
NICHE=impact-news                   # daily impact news/info explainers (India + world)
NICHE_LEAN=soft-positive            # science/tech/economy/breakthroughs; avoid partisan/communal
CONTENT_STYLE=daily-impact-explainer   # what happened -> why it matters -> impact
DIGEST_HOUR_UTC=02                  # 08:00 IST ~= 02:30 UTC (adjust to your timezone)
ENABLE_FALLBACK_IDEATION=true       # use Gemini/Groq only if Claude didn't produce ideas
AI_DISCLOSURE=true                  # set YouTube altered/synthetic flag + disclosure line
MIN_SOURCES=2                       # min independent sources before an idea becomes a reel
DAILY_REEL_CAP=3                    # max Shorts produced per run (operator ships 3/day)
APPROVAL_CAP=3                      # max approvals accepted per digest; keep == DAILY_REEL_CAP
                                    # so the queue can't outrun what production will actually make
ENABLE_HUMAN_ANGLE=true             # require a genuine "why it matters" take (originality / anti-AI-slop)

# Fact-check gate (src/factcheck.py). Since the channel is truth-first rather than neutral — it
# may reach a verdict and assign responsibility — verification is a GATE, not advice: every
# finished script is re-checked against live search before it is voiced, and a FABRICATED claim
# blocks that reel (the idea is marked rejected so it cannot retry-loop).
ENABLE_FACT_CHECK=                  # true (default) | false — false disables the gate entirely
FACTCHECK_SEVERITY=                 # critical (default) | any — WHICH findings block.
                                    # critical: only fabrication blocks (event didn't happen,
                                    # wrong party blamed, invented quote/law/stat, a number wrong
                                    # enough to flip the conclusion). Rounding, a slightly
                                    # different figure, a date off by a day, wording, and
                                    # "couldn't confirm but nothing contradicts it" are logged
                                    # and WAIVED. Set 2026-08-07 after the original all-or-
                                    # nothing gate blocked most ideas over differences that
                                    # changed nothing — a gate that stops everything protects
                                    # nothing. `any` restores block-on-every-discrepancy.
FACTCHECK_STRICT=                   # false (default) | true — what to do when the CHECKER itself
                                    # cannot run. false = ship unverified and log loudly;
                                    # true = block. Choose which risk you prefer.
                                    # (Independent of FACTCHECK_SEVERITY: that grades real
                                    # findings, this governs the checker being unable to answer.)
FACTCHECK_MODEL=                    # LEAVE UNSET. Quota is metered per model, which suggests
                                    # giving the checker its own — but measured 2026-07-27 on
                                    # this account, every other grounded model returns
                                    # `limit: 0` (no free allowance). Only gemini-2.5-flash has
                                    # a real free budget: 20 req/day, SHARED by grounded
                                    # ideation + scriptwriter + fact check (~8/day at 3 Shorts,
                                    # so it fits). Setting this to a zero-quota model makes the
                                    # gate fail every time = permanently fail-open.
NEWS_RSS_URL=                       # optional: override the Google News RSS feed that seeds ideation
TRENDS_GEO=                         # Google Trends locale for the supplementary signal (default IN)
ENABLE_HOOK_JUDGE=                  # true (default) | false — a cheap LLM pass scores the opening
                                    # hook and rewrites it ONLY if weak. Never changes a fact.
HOOK_MIN_SCORE=                     # rewrite below this 1-10 score (default 7)
ENABLE_DESC_FOOTER=                 # true (default) | false — brand + subscribe block on every
                                    # description; idempotent and length-capped
DESCRIPTION_FOOTER=                 # optional: replace the default footer copy
DRAIN_SECONDS=                      # how long run() drains Telegram decisions (default 20)
WORK_DIR=                           # render scratch root (default a temp dir). Contents are
                                    # deleted after each reel — never point this at real files.
